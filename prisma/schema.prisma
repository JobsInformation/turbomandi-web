datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Vehicle {
  id        String   @id @default(uuid())
  name      String
  price     Float
  odometer  String
  status    String   @default("Available")
  body      String   @default("SUV")
  fuel      String   @default("Petrol")
  trans     String   @default("Auto")
  createdAt DateTime @default(now())
}

model Lead {
  id        String   @id @default(uuid())
  name      String
  email     String
  phone     String
  message   String?
  vehicle   String?
  createdAt DateTime @default(now())
}

model FinanceApp {
  id               String   @id @default(uuid())
  name             String
  email            String
  phone            String
  employmentStatus String
  loanAmount       Float
  status           String   @default("Pending")
  createdAt        DateTime @default(now())
}
