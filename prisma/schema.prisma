datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Vehicle {
  id        String   @id @default(uuid())
  name      String
  price     Float
  odometer  String
  status    String   @default("Available")
  body      String   @default("SUV")
  fuel      String   @default("Petrol")
  trans     String   @default("Auto")
  createdAt DateTime @default(now())
}

model Part {
  id          String   @id @default(uuid())
  name        String
  partNumber  String   @unique
  price       Float
  stock       Int      @default(0)
  createdAt   DateTime @default(now())
}

model ServiceBooking {
  id          String   @id @default(uuid())
  name        String
  email       String
  phone       String
  serviceType String
  date        String
  status      String   @default("Pending")
  createdAt   DateTime @default(now())
}

model Order {
  id          String   @id @default(uuid())
  customerName String
  total       Float
  status      String   @default("Completed")
  createdAt   DateTime @default(now())
}

model Lead {
  id        String   @id @default(uuid())
  name      String
  email     String
  phone     String
  message   String?
  vehicle   String?
  createdAt DateTime @default(now())
}

model FinanceApp {
  id               String   @id @default(uuid())
  name             String
  email            String
  phone            String
  employmentStatus String
  loanAmount       Float
  status           String   @default("Pending")
  createdAt        DateTime @default(now())
}
